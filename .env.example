# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# The real environment always wins over this file (see app/config.py), which is
# what lets a deployment set these as platform variables and ignore .env
# entirely. Every integration below is optional except the ADMIN_* block —
# missing keys reduce capability, they never stop a run.


# --- required: nothing can run without these -------------------------------

# The nopCommerce admin to drive, including the /Admin path.
ADMIN_BASE_URL=https://your-shop.example.com/Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=


# --- optional: colour resolution tier 3 ------------------------------------
# Without a key, tier 3 is off and colours the curated map and the heuristic
# cannot resolve fail loudly instead of being inferred.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini


# --- optional: the run store / observability -------------------------------
# Without these, runs are kept in memory only: the console still works and
# history is lost on restart. Apply app/store/schema.sql once before use.
# SUPABASE_SERVICE_KEY bypasses row-level security — backend only, never
# anywhere a browser can read it.

SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Postgres wire-protocol URL. Used only by sql.py to apply DDL, because
# PostgREST cannot. The application itself never reads it.
SUPABASE_DB_URL=


# --- serving ---------------------------------------------------------------
# Both have working defaults; you normally set neither locally. A container
# sets HOST=0.0.0.0 (the Dockerfile does) and the platform injects PORT.

# HOST=127.0.0.1
# PORT=8000

# Origins allowed to call the API, comma-separated, or "*" for any. There is no
# cross-origin traffic when one container serves both the console and the API,
# so this does nothing until something is put in front of it.
# CORS_ALLOW_ORIGINS=*


# --- run behaviour ---------------------------------------------------------
# Debugging knobs. NOP_HEADED must stay off on a server: there is no display,
# so a headed launch cannot start.

# NOP_HEADED=0
# NOP_SLOWMO=0
